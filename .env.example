# argus-sec — environment configuration
# Copy this file to .env and fill in real values.
# .env is in .gitignore — NEVER commit real secrets.

# ---------------------------------------------------------------------------
# PostgreSQL 16
# ---------------------------------------------------------------------------
POSTGRES_USER=argus
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=argus_sec
POSTGRES_PORT=5433

# ---------------------------------------------------------------------------
# Qdrant v1.17.1
# ---------------------------------------------------------------------------
# API key — required. Generate with: openssl rand -hex 32
QDRANT_API_KEY=changeme_qdrant_api_key
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=cve_chunks

# ---------------------------------------------------------------------------
# Ingestion settings
# ---------------------------------------------------------------------------
# Path to chunks.json inside the container (mounted from host)
CHUNKS_PATH=/app/data/chunks.json

# BM25 index output path inside the container
BM25_INDEX_PATH=/app/data/bm25_index.pkl

# FastEmbed model — same as nexus-ai-gateway for consistency
# Embedding dimension: 384 (BAAI/bge-small-en-v1.5)
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# FastEmbed cache directory inside the container
FASTEMBED_CACHE_DIR=/app/.fastembed_cache

# Qdrant upsert batch size — tune based on available memory
# 912 CVEs total; 64 is safe for a 2GB container
QDRANT_BATCH_SIZE=64

# PostgreSQL batch insert size
PG_BATCH_SIZE=100

# ---------------------------------------------------------------------------
# Internal service URLs (used by ingest container — do not change)
# ---------------------------------------------------------------------------
POSTGRES_URL=postgresql://argus:${POSTGRES_PASSWORD}@postgres:5433/argus_sec
QDRANT_URL=http://qdrant:6333
